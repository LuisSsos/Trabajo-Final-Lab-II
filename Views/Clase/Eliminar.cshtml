@model Gimnasio.Models.ViewModels.ClaseViewModel

@{
    ViewData["Title"] = "Eliminar clase";
}

<h1>Eliminar clase</h1>

<hr />

<div class="card shadow-sm">

    <div class="card-body">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="alert alert-warning">
            ¿Estás seguro de que querés eliminar esta clase?
            Esta acción no se puede deshacer.
        </div>

        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Cupo máximo</dt>
            <dd class="col-sm-9">@Model.CupoMaximo</dd>

            <dt class="col-sm-3">Entrenador</dt>
            <dd class="col-sm-9">@Model.NombreEntrenador</dd>

        </dl>

        <form asp-action="EliminarConfirmado" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

        </form>

    </div>

</div>
