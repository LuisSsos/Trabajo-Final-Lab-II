@model Gimnasio.Models.ViewModels.ClaseViewModel

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CupoMaximo" class="form-label"></label>
    <input asp-for="CupoMaximo" type="number" min="1" max="500" class="form-control" />
    <span asp-validation-for="CupoMaximo" class="text-danger"></span>
</div>

<div class="mb-3 position-relative">
    <label asp-for="NombreEntrenador" class="form-label"></label>

    <input asp-for="NombreEntrenador" class="form-control" autocomplete="off"
           placeholder="Escribí el nombre o apellido del entrenador" v-model="terminoEntrenador"
    v-on:focus="buscarEntrenadores" v-on:input="programarBusqueda" />

    <input type="hidden" asp-for="EmpleadoId" />

    <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 10;"
         v-if="entrenadores.length > 0 || buscandoEntrenadores">

        <div v-if="buscandoEntrenadores" class="list-group-item text-muted">
            Buscando entrenadores...
        </div>

        <button v-for="entrenador in entrenadores" :key="entrenador.id" type="button"
                class="list-group-item list-group-item-action" v-on:click="seleccionarEntrenador(entrenador)">
            {{ entrenador.nombre }}
        </button>
    </div>

    <span asp-validation-for="EmpleadoId" class="text-danger"></span>
</div>