@{
    ViewData["Title"] = "Clases";
}

<div id="app" data-listar-url="@Url.Action("ListarAjax", "Clase")"
     data-detalles-url="@Url.Action("Detalles", "Clase", new { id = "__id__" })"
     data-editar-url="@Url.Action("Editar", "Clase", new { id = "__id__" })"
     data-eliminar-url="@Url.Action("Eliminar", "Clase", new { id = "__id__" })"
     data-crear-url="@Url.Action("Crear", "Clase")"
     data-buscar-url="@Url.Action("BuscarEntrenadores", "Clase")">

    <form class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Clases</h1>
            <p class="text-muted mb-0">
                Consulta y administra las clases del gimnasio.
            </p>
        </div>

        <button type="button" class="btn btn-primary" v-on:click="abrirCrear">
            Nueva clase
        </button>
    </div>

    <div v-if="mensajeExito" class="alert alert-success">
        {{ mensajeExito }}
    </div>

    <div v-if="mostrarFormulario" class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">{{ modo === 'crear' ? 'Nueva clase' : 'Editar clase' }}</h5>
        </div>

        <div class="card-body">
            <div v-if="mensajeFormulario" class="alert alert-danger">
                {{ mensajeFormulario }}
            </div>

            <form v-on:submit.prevent="guardar">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control"
                               :class="{ 'is-invalid': errorDe('Nombre') }"
                               v-model="formulario.nombre" />
                        <div class="invalid-feedback">{{ errorDe('Nombre') }}</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cupo máximo</label>
                        <input type="number" min="1" max="500" class="form-control"
                               :class="{ 'is-invalid': errorDe('CupoMaximo') }"
                               v-model="formulario.cupoMaximo" />
                        <div class="invalid-feedback">{{ errorDe('CupoMaximo') }}</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea rows="3" class="form-control"
                                  :class="{ 'is-invalid': errorDe('Descripcion') }"
                                  v-model="formulario.descripcion"></textarea>
                        <div class="invalid-feedback">{{ errorDe('Descripcion') }}</div>
                    </div>

                    <div class="col-md-6 position-relative" ref="buscador">
                        <label class="form-label">Entrenador</label>
                        <input type="text" class="form-control" autocomplete="off"
                               placeholder="Escribí el nombre o apellido del entrenador"
                               :class="{ 'is-invalid': errorDe('EmpleadoId') }"
                               v-model="formulario.nombreEntrenador"
                               v-on:focus="buscarEntrenadores"
                               v-on:input="programarBusqueda" />

                        <div v-if="listaAbierta" class="list-group position-absolute w-100 shadow-sm" style="z-index: 10;">
                            <div v-if="buscandoEntrenadores" class="list-group-item text-muted">
                                Buscando entrenadores...
                            </div>
                            <div v-else-if="entrenadores.length === 0" class="list-group-item text-muted">
                                No se encontraron entrenadores
                            </div>
                            <template v-else>
                                <button v-for="entrenador in entrenadores" :key="entrenador.id"
                                        type="button" class="list-group-item list-group-item-action"
                                        v-on:click="seleccionarEntrenador(entrenador)">
                                    {{ entrenador.nombre }}
                                </button>
                            </template>
                        </div>

                        <div class="invalid-feedback">{{ errorDe('EmpleadoId') }}</div>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary" :disabled="guardando">
                        {{ guardando ? 'Guardando...' : (modo === 'crear' ? 'Crear clase' : 'Guardar cambios') }}
                    </button>
                    <button type="button" class="btn btn-secondary" :disabled="guardando" v-on:click="cancelar">
                        Cancelar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Listado de clases</h5>
        </div>

        <div class="card-body">
            <div v-if="cargando" class="alert alert-info">
                Cargando clases...
            </div>

            <div v-if="error" class="alert alert-danger">
                {{ error }}
            </div>

            <div v-if="!cargando && !error && clases.length === 0" class="alert alert-info">
                No hay clases registradas.
            </div>

            <div v-if="clases.length > 0" class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Entrenador</th>
                            <th>Cupo máximo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr v-for="clase in clases" :key="clase.id">
                            <td>{{ clase.id }}</td>
                            <td>{{ clase.nombre }}</td>
                            <td>{{ clase.nombreEntrenador }}</td>
                            <td>{{ clase.cupoMaximo }}</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a :href="urlConId(urlDetalles, clase.id)" class="btn btn-sm btn-outline-primary">
                                        Ver
                                    </a>

                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            v-on:click="abrirEditar(clase)">
                                        Editar
                                    </button>

                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            :disabled="eliminandoId !== null" v-on:click="eliminarClase(clase)">
                                        {{ eliminandoId === clase.id ? 'Eliminando...' : 'Eliminar' }}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div v-if="totalPaginas > 1" class="d-flex justify-content-center mt-3">
                <nav aria-label="Paginación de clases">
                    <ul class="pagination mb-0">
                        <li class="page-item" :class="{ disabled: paginaActual <= 1 || cargando }">
                            <button type="button" class="page-link" :disabled="paginaActual <= 1 || cargando"
                                v-on:click="cambiarPagina(paginaActual - 1)">
                                Anterior
                            </button>
                        </li>

                        <li v-for="pagina in totalPaginas" :key="pagina" class="page-item"
                            :class="{ active: pagina === paginaActual }">
                            <button type="button" class="page-link" :disabled="cargando"
                                v-on:click="cambiarPagina(pagina)">
                                {{ pagina }}
                            </button>
                        </li>

                        <li class="page-item" :class="{ disabled: paginaActual >= totalPaginas || cargando }">
                            <button type="button" class="page-link" :disabled="paginaActual >= totalPaginas || cargando"
                                v-on:click="cambiarPagina(paginaActual + 1)">
                                Siguiente
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>

            <div v-if="!cargando && !error && clases.length > 0" class="text-muted small mt-3">
                Clases en esta página: {{ clases.length }}
                · Página {{ paginaActual }} de {{ totalPaginas }}
            </div>
        </div>
    </div>
</div>

<script src="~/lib/vue/vue.global.prod.js"></script>

<script>
    (() => {
        const elemento = document.getElementById('app');

        const listarUrl = elemento.dataset.listarUrl;
        const urlDetalles = elemento.dataset.detallesUrl;
        const urlEditar = elemento.dataset.editarUrl;
        const urlEliminar = elemento.dataset.eliminarUrl;
        const urlCrear = elemento.dataset.crearUrl;
        const urlBuscar = elemento.dataset.buscarUrl;

        const formularioVacio = () => ({
            id: 0,
            nombre: '',
            descripcion: '',
            cupoMaximo: '',
            empleadoId: '',
            nombreEntrenador: ''
        });

        Vue.createApp({
            data() {
                return {
                    clases: [],
                    paginaActual: 1,
                    totalPaginas: 1,
                    cargando: true,
                    error: null,
                    eliminandoId: null,
                    urlDetalles,
                    urlEditar,
                    urlEliminar,

                    mostrarFormulario: false,
                    modo: 'crear',
                    formulario: formularioVacio(),
                    guardando: false,
                    erroresFormulario: {},
                    mensajeFormulario: '',
                    mensajeExito: '',

                    entrenadores: [],
                    listaAbierta: false,
                    buscandoEntrenadores: false,
                    temporizador: null
                };
            },

            methods: {
                urlConId(url, id) {
                    return url.replace('__id__', id);
                },

                obtenerToken() {
                    return document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    )?.value;
                },

                async cargarClases(pagina = 1) {
                    this.cargando = true;
                    this.error = null;

                    try {
                        const respuesta = await fetch(
                            `${listarUrl}?pagina=${pagina}`
                        );

                        if (!respuesta.ok) {
                            throw new Error('No se pudieron cargar las clases.');
                        }

                        const datos = await respuesta.json();

                        this.clases = datos.items;
                        this.paginaActual = datos.paginaActual;
                        this.totalPaginas = datos.totalPaginas;
                    } catch (error) {
                        console.error(error);
                        this.error =
                            'Ocurrió un error al cargar las clases. Intentá nuevamente.';
                    } finally {
                        this.cargando = false;
                    }
                },

                cambiarPagina(pagina) {
                    if (
                        pagina < 1 ||
                        pagina > this.totalPaginas ||
                        pagina === this.paginaActual ||
                        this.cargando
                    ) {
                        return;
                    }

                    this.cargarClases(pagina);
                },

                errorDe(campo) {
                    const lista = this.erroresFormulario[campo];
                    return lista && lista.length > 0 ? lista[0] : '';
                },

                abrirCrear() {
                    this.modo = 'crear';
                    this.formulario = formularioVacio();
                    this.erroresFormulario = {};
                    this.mensajeFormulario = '';
                    this.mensajeExito = '';
                    this.listaAbierta = false;
                    this.mostrarFormulario = true;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                },

                abrirEditar(clase) {
                    this.modo = 'editar';
                    this.formulario = {
                        id: clase.id,
                        nombre: clase.nombre,
                        descripcion: clase.descripcion ?? '',
                        cupoMaximo: clase.cupoMaximo,
                        empleadoId: clase.empleadoId,
                        nombreEntrenador: clase.nombreEntrenador
                    };
                    this.erroresFormulario = {};
                    this.mensajeFormulario = '';
                    this.mensajeExito = '';
                    this.listaAbierta = false;
                    this.mostrarFormulario = true;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                },

                cancelar() {
                    this.mostrarFormulario = false;
                    this.listaAbierta = false;
                },

                async buscarEntrenadores() {
                    this.listaAbierta = true;
                    this.buscandoEntrenadores = true;

                    try {
                        const termino = encodeURIComponent(
                            this.formulario.nombreEntrenador || ''
                        );

                        const respuesta = await fetch(`${urlBuscar}?termino=${termino}`);

                        if (!respuesta.ok) {
                            throw new Error('No se pudo buscar.');
                        }

                        this.entrenadores = await respuesta.json();
                    } catch (error) {
                        console.error(error);
                        this.entrenadores = [];
                    } finally {
                        this.buscandoEntrenadores = false;
                    }
                },

                programarBusqueda() {
                    // si se vuelve a escribir, hay que elegir de nuevo de la lista
                    this.formulario.empleadoId = '';
                    clearTimeout(this.temporizador);
                    this.temporizador = setTimeout(() => this.buscarEntrenadores(), 300);
                },

                seleccionarEntrenador(entrenador) {
                    this.formulario.empleadoId = entrenador.id;
                    this.formulario.nombreEntrenador = entrenador.nombre;
                    this.listaAbierta = false;
                },

                async guardar() {
                    if (this.guardando) {
                        return;
                    }

                    this.guardando = true;
                    this.mensajeFormulario = '';
                    this.erroresFormulario = {};
                    this.mensajeExito = '';

                    try {
                        const token = this.obtenerToken();

                        if (!token) {
                            throw new Error('No se encontró el token de seguridad.');
                        }

                        const esEdicion = this.modo === 'editar';

                        const url = esEdicion
                            ? this.urlConId(this.urlEditar, this.formulario.id)
                            : urlCrear;

                        const respuesta = await fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: new URLSearchParams({
                                Id: this.formulario.id,
                                Nombre: this.formulario.nombre,
                                Descripcion: this.formulario.descripcion ?? '',
                                CupoMaximo: this.formulario.cupoMaximo,
                                EmpleadoId: this.formulario.empleadoId,
                                NombreEntrenador: this.formulario.nombreEntrenador,
                                __RequestVerificationToken: token
                            })
                        });

                        const datos = await respuesta.json();

                        if (!respuesta.ok || !datos.success) {
                            this.erroresFormulario = datos.errores || {};
                            this.mensajeFormulario =
                                datos.mensaje || 'No se pudo guardar la clase.';
                            return;
                        }

                        this.mensajeExito = datos.mensaje;
                        this.mostrarFormulario = false;
                        await this.cargarClases(this.paginaActual);
                    } catch (error) {
                        console.error(error);
                        this.mensajeFormulario =
                            error.message || 'Ocurrió un error al guardar la clase.';
                    } finally {
                        this.guardando = false;
                    }
                },

                async eliminarClase(clase) {
                    const confirmar = window.confirm(
                        `¿Querés eliminar la clase "${clase.nombre}" y todos sus horarios asociados?`
                    );

                    if (!confirmar || this.eliminandoId !== null) {
                        return;
                    }

                    this.eliminandoId = clase.id;
                    this.error = null;
                    this.mensajeExito = '';

                    try {
                        const url = this.urlConId(this.urlEliminar, clase.id);
                        const token = this.obtenerToken();

                        if (!token) {
                            throw new Error(
                                'No se encontró el token de seguridad para eliminar la clase.'
                            );
                        }

                        const respuesta = await fetch(
                            url.replace('/Eliminar', '/EliminarConfirmado'),
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: new URLSearchParams({
                                    id: clase.id,
                                    __RequestVerificationToken: token
                                })
                            }
                        );

                        const datos = await respuesta.json();

                        if (!respuesta.ok || !datos.success) {
                            throw new Error(
                                datos.mensaje || 'No se pudo eliminar la clase.'
                            );
                        }

                        this.clases = this.clases.filter(
                            elemento => elemento.id !== clase.id
                        );

                        if (this.clases.length === 0 && this.paginaActual > 1) {
                            await this.cargarClases(this.paginaActual - 1);
                        } else {
                            await this.cargarClases(this.paginaActual);
                        }
                    } catch (error) {
                        console.error(error);
                        this.error =
                            error.message || 'Ocurrió un error al eliminar la clase.';
                    } finally {
                        this.eliminandoId = null;
                    }
                }
            },

            mounted() {
                this.cargarClases();

                this.manejarClickFuera = (evento) => {
                    const contenedor = this.$refs.buscador;

                    if (contenedor && !contenedor.contains(evento.target)) {
                        this.listaAbierta = false;
                    }
                };

                document.addEventListener('click', this.manejarClickFuera);
            },

            beforeUnmount() {
                document.removeEventListener('click', this.manejarClickFuera);
                clearTimeout(this.temporizador);
            }
        }).mount('#app');
    })();
</script>