@model Gimnasio.Models.ViewModels.ClaseViewModel

@{
    ViewData["Title"] = "Editar clase";
}

<div id="crearClaseApp" v-cloak>
    <h1>Editar clase</h1>

    <p class="text-muted">
        Modificá los datos de la clase y guardá los cambios.
    </p>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Editar" asp-route-id="@Model.Id"
                  method="post" @@submit.prevent="crearClase">

                <input type="hidden" asp-for="Id" />

                <div v-if="mensajeError" class="alert alert-danger">
                    {{ mensajeError }}

                    <ul v-if="errores.length > 0" class="mb-0 mt-2">
                        <li v-for="(error, indice) in errores" :key="indice">
                            {{ error }}
                        </li>
                    </ul>
                </div>

                <div v-if="enviando" class="alert alert-info">
                    Guardando cambios...
                </div>

                <partial name="_CamposClase" model="Model" />

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-primary"
                            :disabled="enviando">
                        {{ enviando ? 'Guardando...' : 'Guardar cambios' }}
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/vue/vue.global.prod.js"></script>
    <partial name="_ScriptsClase" />
}