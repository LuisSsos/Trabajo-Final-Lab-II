@model Gimnasio.Models.Plan

@{
    ViewData["Title"] = "Detalles del plan";
}

<h1>Detalles del plan</h1>

<hr />

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Precio</dt>
            <dd class="col-sm-9">$@Model.Precio.ToString("N2")</dd>

            <dt class="col-sm-3">Duración (días)</dt>
            <dd class="col-sm-9">@Model.DuracionDias</dd>

        </dl>

        <div class="mt-4">

            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>

        </div>

    </div>
</div>
