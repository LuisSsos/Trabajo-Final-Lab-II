@model Gimnasio.Models.ViewModels.MembresiaViewModel

@{
    ViewData["Title"] = "Eliminar membresía";
}

<h1>Eliminar membresía</h1>

<hr />

<div class="card shadow-sm">

    <div class="card-body">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="alert alert-warning">
            ¿Estás seguro de que querés eliminar esta membresía?
            Esta acción no se puede deshacer.
        </div>

        <dl class="row">

            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.NombreCliente</dd>

            <dt class="col-sm-3">Plan</dt>
            <dd class="col-sm-9">@Model.NombrePlan</dd>

            <dt class="col-sm-3">Período</dt>
            <dd class="col-sm-9">@Model.FechaInicio?.ToString("dd/MM/yyyy") al @Model.FechaFin?.ToString("dd/MM/yyyy")</dd>

        </dl>

        <form asp-action="EliminarConfirmado" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

        </form>

    </div>

</div>
