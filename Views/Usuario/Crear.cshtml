@model Gimnasio.Models.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

<!-- Encabezado -->
<div class="mb-4">
    <h1 class="mb-1">Nuevo usuario</h1>
    <p class="text-muted mb-0">
        Completá los datos para registrar un usuario en el gimnasio.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">

        <div class="card shadow-sm">

<!-- Título de la tarjeta -->
            <div class="card-header p-3 p-md-4">
                <h2 class="h5 mb-1">Información del usuario</h2>
                <p class="text-muted small mb-0">
                    Los campos se validarán antes de guardar los datos.
                </p>
            </div>

            <div class="card-body p-3 p-md-4">

                <form asp-action="Crear" method="post" enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<!-- Datos personales -->
                    <div class="mb-4">

                        <h3 class="h6 text-primary fw-bold mb-3">
                            Datos personales
                        </h3>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label"></label>

                                <input asp-for="Nombre" class="form-control" placeholder="Ingresá el nombre" autocomplete="given-name" />

                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Apellido" class="form-label"></label>

                                <input asp-for="Apellido" class="form-control" placeholder="Ingresá el apellido" autocomplete="family-name" />

                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>

                                <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" autocomplete="email" />

                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label"></label>

                                <input asp-for="Telefono" type="tel" class="form-control" placeholder="Ingresá el teléfono" autocomplete="tel" />

                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

 <!-- Cuenta y acceso -->
                    <div class="mb-4">

                        <h3 class="h6 text-primary fw-bold mb-3">
                            Cuenta y acceso
                        </h3>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label"></label>

                                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />

                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Rol" class="form-label"></label>

                                <select asp-for="Rol" class="form-select">

                                    <option value="">-- Elegir rol --</option>
                                    <option value="Recepcionista">Recepcionista</option>
                                    <option value="Entrenador">Entrenador</option>
                                    <option value="Nutricionista">Nutricionista</option>
                                    <option value="Administrativo">Administrativo</option>
                                    <option value="Cliente">Cliente</option>

                                </select>

                                <span asp-validation-for="Rol" class="text-danger small"></span>

                                <div class="form-text">
                                    El rol determina los permisos del usuario.
                                </div>
                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

 <!-- Archivos -->
                    <div class="mb-2">

                        <h3 class="h6 text-primary fw-bold mb-3">
                            Archivos y documentación
                        </h3>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="ArchivoAvatar" class="form-label">
                                    Avatar
                                    <span class="text-muted fw-normal">
                                        (opcional)
                                    </span>
                                </label>

                                <input asp-for="ArchivoAvatar" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />

                                <span asp-validation-for="ArchivoAvatar" class="text-danger small"></span>

                                <div class="form-text">
                                    Formatos permitidos: JPG, PNG y WEBP.
                                </div>
                            </div>

                            <div class="col-md-6 mb-3" id="campoFechaNacimiento">

                                <label asp-for="FechaNacimiento" class="form-label">
                                    Fecha de nacimiento
                                </label>

                                <input asp-for="FechaNacimiento" type="date" class="form-control"
                                       min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                                <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>

                                <div class="form-text">
                                    Campo requerido para los clientes, según las
                                    validaciones del sistema.
                                </div>
                            </div>

                            <div class="col-md-6 mb-3" id="campoAptoMedico">

                                <label for="ArchivoAptoMedico" class="form-label">
                                    Apto médico
                                    <span class="text-muted fw-normal">
                                        (opcional)
                                    </span>
                                </label>

                                <input type="file" id="ArchivoAptoMedico" name="ArchivoAptoMedico" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />

                                <div class="form-text">
                                    Formatos permitidos: PDF, JPG y PNG.
                                </div>
                            </div>

                        </div>

                    </div>

 <!-- Acciones -->
                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">

                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancelar
                        </a>

                        <button type="submit" class="btn btn-primary px-4">
                            Crear usuario
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const selectorRol = document.getElementById("Rol");
        const campoFecha = document.getElementById("campoFechaNacimiento");
        const campoAptoMedico = document.getElementById("campoAptoMedico");

        function mostrarCampos() {
            const esCliente = selectorRol.value === "Cliente";

            campoFecha.style.display = esCliente ? "" : "none";
            campoAptoMedico.style.display = esCliente ? "" : "none";
        }

        selectorRol.addEventListener("change", mostrarCampos);
        mostrarCampos();
    </script>
}
