@model Gimnasio.Models.ViewModels.UsuarioViewModel

@{
    ViewData["Title"] = "Detalles del usuario";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Detalles del usuario</h1>
            <p class="text-muted mb-0">
                Información de la cuenta seleccionada.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Volver al listado
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h5 mb-0">Información personal</h2>
        </div>

        <div class="card-body p-4">
            <div class="row g-4 align-items-center mb-4">
                <div class="col-auto">
                    @{
                        ViewData["Tamano"] = 100;
                    }

                    <partial name="_Avatar" model="Model" />
                </div>

                <div class="col">
                    <h3 class="h4 mb-1">
                        @Model.Nombre @Model.Apellido
                    </h3>
                    <p class="text-muted mb-0">
                        Usuario #@Model.Id
                    </p>
                </div>
            </div>

            <hr />

            @if (Model.EsCliente)
            {
                <hr />

                <h3 class="h5 mb-3">Datos de cliente</h3>

                <dl class="row mb-0">
                    <dt class="col-sm-3 py-2">DNI</dt>
                    <dd class="col-sm-9 py-2">
                        @(string.IsNullOrWhiteSpace(Model.Dni) ? "-" : Model.Dni)
                    </dd>

                    <dt class="col-sm-3 py-2">Fecha de nacimiento</dt>
                    <dd class="col-sm-9 py-2">
                        @(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")
                    </dd>

                    <dt class="col-sm-3 py-2">Apto médico</dt>
                    <dd class="col-sm-9 py-2">
                        @if (!string.IsNullOrWhiteSpace(Model.AptoMedico))
                        {
                            <a href="@Model.AptoMedico" target="_blank" class="btn btn-sm btn-outline-primary">
                                Ver comprobante
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">Sin apto médico</span>
                        }
                    </dd>
                </dl>
            }

            <hr class="my-4" />

            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                    Editar usuario
                </a>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Volver al listado
                </a>
            </div>
        </div>
    </div>
</div>